---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { diagnosticoEndpoint, site } from '../lib/site';
import '../styles/formulario.css';

/**
 * Filtro de entrada, em etapas.
 *
 * As perguntas vivem no banco e são editadas pelo painel: o formulário é
 * desenhado no navegador por src/lib/formulario.ts. Se o banco não
 * responder, entra a cópia de reserva de src/lib/formulario-padrao.ts.
 */
---

<Base
  title="Diagnóstico | FEITTO"
  description="Três minutos para saber se faz sentido. Um filtro que funciona nos dois sentidos, lido pessoalmente pela Luana Feitoza."
  bare
>
  <Logo slot="bare-logo" width={132} />

  <!-- abertura: sai de cena assim que o formulário começa -->
  <section class="shell abertura" id="abertura">
    <div class="abertura__left">
      <p class="eyebrow">Diagnóstico de Inteligência Comercial</p>
      <h1 class="abertura__title">
        Três minutos para saber se <em class="key">faz sentido</em>.
      </h1>
      <p class="lede">
        A FEITTO trabalha com um número limitado de empresas por semestre. Este formulário existe
        para a gente entender, com honestidade, se o seu momento e o nosso método se encontram.
      </p>
      <p class="lede">Responda com sinceridade, porque é dela que sai uma leitura que presta.</p>
      <button type="button" class="btn btn--solid abertura__cta" data-comecar>Começar</button>
    </div>

    <aside class="nota">
      <p class="nota__rotulo">Antes de você começar</p>
      <p>
        O que você escrever aqui é lido só por mim e pela nossa equipe. Não vira lista, não vira
        anúncio e não vira exemplo em lugar nenhum.
      </p>
    </aside>
  </section>

  <form class="shell form" id="diagnostico">
    <p class="form__carregando" data-carregando>Carregando as perguntas…</p>
    <noscript>
      <p class="form__sem-js">
        O diagnóstico precisa de JavaScript ligado. Se preferir, me escreva em
        <a href={`mailto:${site.email}`}>{site.email}</a> contando o seu momento, que eu leio do
        mesmo jeito.
      </p>
    </noscript>
  </form>

  <section class="shell section depois" data-depois>
    <div class="rule">
      <span class="rule__num" aria-hidden="true">→</span>
      <span class="rule__label">O que acontece depois</span>
    </div>

    <ol class="passos">
      <li class="passo">
        <span class="passo__num">01</span>
        <p>Eu leio pessoalmente. Aqui não tem resposta automática.</p>
      </li>
      <li class="passo">
        <span class="passo__num">02</span>
        <p>
          Havendo encaixe, você recebe um contato pelo WhatsApp em até dois dias úteis, já com uma
          primeira leitura do seu caso.
        </p>
      </li>
      <li class="passo">
        <span class="passo__num">03</span>
        <p>
          Se não houver, eu te falo isso com clareza e, quando der, aponto um caminho que sirva para
          o seu momento.
        </p>
      </li>
    </ol>
  </section>

  <section class="confirma" id="confirmacao" hidden tabindex="-1">
    <div class="shell">
      <div class="confirma__grid">
        <h2 class="confirma__title">Recebemos suas respostas.</h2>
        <div class="confirma__texto">
          <p>
            Cada diagnóstico é lido pessoalmente, então não espere um retorno automático. Havendo
            encaixe entre o seu momento e o nosso método, a gente procura você pelo WhatsApp que
            ficou aí em cima.
          </p>
          <p class="confirma__forte">Obrigada pela sinceridade. É dela que a clareza começa.</p>
          <a href="/" class="link-rule confirma__voltar">
            Voltar ao início <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .abertura {
    display: grid;
    gap: clamp(2rem, 5vw, 7.5rem);
    padding-block-start: clamp(3.5rem, 6vw, 5.75rem);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .abertura {
      grid-template-columns: minmax(0, 43.75rem) minmax(0, 1fr);
    }
  }
  .abertura[hidden] {
    display: none;
  }
  .abertura__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.375rem;
  }
  .abertura__title {
    margin-block: 2rem 0.75rem;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.028em;
  }
  .abertura__cta {
    margin-block-start: 1.375rem;
  }

  .nota {
    border-inline-start: 2px solid var(--drift);
    padding-inline-start: 2.125rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--coffee);
  }
  @media (min-width: 62rem) {
    .nota {
      margin-block-start: 3.75rem;
    }
  }
  .nota__rotulo {
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--drift-ink);
  }

  .form {
    padding-block-start: clamp(2.5rem, 5vw, 4rem);
  }
  .form__carregando {
    max-width: 44rem;
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--drift);
  }
  .form__sem-js {
    max-width: 44rem;
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .form__sem-js a {
    color: var(--ink);
  }

  /* o que acontece depois */
  .depois[hidden] {
    display: none;
  }
  .passos {
    display: grid;
    gap: 2rem 0;
    margin: clamp(2rem, 3vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 62rem) {
    .passos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .passo {
      padding-inline-end: 4rem;
    }
    .passo + .passo {
      border-inline-start: 1px solid var(--hairline);
      padding-inline-start: 4rem;
    }
  }
  .passo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .passo__num {
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    color: var(--drift);
  }
  .passo p {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.7;
  }

  /* confirmação */
  .confirma {
    margin-block-start: clamp(4rem, 7vw, 6.5rem);
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--ink);
    color: var(--silver);
  }
  .confirma[hidden] {
    display: none;
  }
  .confirma__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 7.5rem);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .confirma__grid {
      grid-template-columns: minmax(0, 38.75rem) minmax(0, 1fr);
    }
  }
  .confirma__title {
    font-size: clamp(2.125rem, 4.5vw, 3.125rem);
    color: var(--alyssum);
  }
  .confirma__texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .confirma__texto p {
    line-height: 1.8;
  }
  .confirma__forte {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    color: var(--alyssum);
  }
  .confirma__voltar {
    color: var(--alyssum);
  }
</style>

<script is:inline define:vars={{ endpoint: diagnosticoEndpoint }}>
  window.__FEITTO_ENDPOINT__ = endpoint;
</script>

<script>
  import { carregarDefinicao, montarFormulario, type Controle } from '../lib/formulario';
  import { formularioPadrao } from '../lib/formulario-padrao';

  const form = document.querySelector<HTMLFormElement>('#diagnostico')!;
  const abertura = document.querySelector<HTMLElement>('#abertura')!;
  const comecar = document.querySelector<HTMLButtonElement>('[data-comecar]')!;
  const depois = document.querySelector<HTMLElement>('[data-depois]')!;
  const confirmacao = document.querySelector<HTMLElement>('#confirmacao')!;

  /** Edge Function do Supabase, definida em src/lib/site.ts. */
  const ENDPOINT: string =
    (window as unknown as { __FEITTO_ENDPOINT__?: string }).__FEITTO_ENDPOINT__ ?? '';

  // quem clica em Começar antes das perguntas chegarem é atendido na chegada
  let pediuComeco = false;
  let controle: Controle | null = null;

  comecar.addEventListener('click', () => {
    abertura.hidden = true;
    depois.hidden = true;
    if (controle) controle.comecar();
    else pediuComeco = true;
  });

  carregarDefinicao(ENDPOINT, formularioPadrao).then((definicao) => {
    controle = montarFormulario(form, definicao, {
      endpoint: ENDPOINT,
      rascunho: 'feitto.diagnostico.rascunho',
      aoEnviar() {
        form.hidden = true;
        abertura.hidden = true;
        depois.hidden = true;
        confirmacao.hidden = false;
        confirmacao.scrollIntoView({ behavior: 'smooth', block: 'start' });
        confirmacao.focus({ preventScroll: true });
      },
    });

    if (pediuComeco) controle.comecar();
  });
</script>
