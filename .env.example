# Comentários ficam ACIMA da linha, nunca depois do "=".
# Num arquivo .env tudo o que vem após o "=" é valor, "#" incluído.

# ---------------------------------------------------------------------------
# MCP do Supabase — lido pelo .mcp.json na abertura do Claude Code.
# Sobe em --read-only e escopado a um projeto só.
# Token em: supabase.com/dashboard/account/tokens
# ---------------------------------------------------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Secrets da Edge Function. Nunca chegam ao navegador.
# Publicar com: npx supabase secrets set CHAVE=valor --project-ref <ref>
#
# CLICKUP_TOKEN   perfil -> Settings -> Apps -> API Token
# CLICKUP_LIST_ID o número na URL da lista, em /v/li/<id>
# RATE_LIMIT_SALT gerar com: openssl rand -hex 16
# POLITICA_VERSAO precisa bater com POLICY_VERSION em src/lib/consent.ts
# ---------------------------------------------------------------------------
CLICKUP_TOKEN=
CLICKUP_LIST_ID=
SITE_ORIGIN=https://feitto.com.br
RATE_LIMIT_SALT=
POLITICA_VERSAO=2026-09-20

# ---------------------------------------------------------------------------
# Usado pelo site. É público e aparece no bundle, como deve ser.
# Formato: https://<ref>.supabase.co/functions/v1/diagnostico
# ---------------------------------------------------------------------------
PUBLIC_DIAGNOSTICO_ENDPOINT=
