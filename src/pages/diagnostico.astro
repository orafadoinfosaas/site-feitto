---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

/**
 * Filtro de entrada, em etapas.
 * Nem valor nem prazo aparecem aqui: a capacidade de investir é lida pelos
 * blocos 05 e 06, e o compromisso pelo bloco 07.
 *
 * Sem JavaScript todas as etapas ficam visíveis e o formulário funciona como
 * uma página só — o passo a passo é melhoria progressiva, nunca requisito.
 */

type Campo =
  | { tipo: 'texto'; id: string; label: string; input?: 'tel' | 'email' | 'text'; obrigatorio?: boolean; meia?: boolean }
  | { tipo: 'longo'; id: string; label: string }
  | { tipo: 'escolha'; id: string; label: string; opcoes: string[]; obrigatorio?: boolean };

interface Etapa {
  n: string;
  nome: string;
  titulo: string;
  campos: Campo[];
}

const etapas: Etapa[] = [
  {
    n: '01',
    nome: 'Quem é você',
    titulo: 'Primeiro, quem está do outro lado.',
    campos: [
      { tipo: 'texto', id: 'nome', label: 'Nome completo', obrigatorio: true },
      { tipo: 'texto', id: 'empresa', label: 'Empresa e site ou Instagram', meia: true },
      { tipo: 'texto', id: 'whatsapp', label: 'WhatsApp', input: 'tel', obrigatorio: true, meia: true },
      { tipo: 'texto', id: 'email', label: 'E-mail', input: 'email', obrigatorio: true },
      {
        tipo: 'escolha',
        id: 'chegada',
        label: 'Como você chegou até a FEITTO?',
        opcoes: ['Indicação de alguém', 'Instagram', 'LinkedIn', 'Busca no Google', 'Outro'],
      },
      { tipo: 'texto', id: 'indicou', label: 'Se foi indicação, de quem?' },
      {
        tipo: 'escolha',
        id: 'papel',
        label: 'Qual o seu papel na empresa?',
        opcoes: [
          'Sou fundador(a) ou sócio(a) e decido sobre investimentos',
          'Sou da liderança e influencio, mas não decido sozinho',
          'Sou de outra área ou estou pesquisando para alguém',
        ],
      },
      {
        tipo: 'escolha',
        id: 'momento',
        label: 'Qual é o seu momento?',
        opcoes: [
          'Tenho uma empresa em operação, com faturamento recorrente',
          'Estou estruturando um negócio novo ou em transição de carreira',
        ],
        obrigatorio: true,
      },
      {
        tipo: 'escolha',
        id: 'segmento',
        label: 'Em que segmento você atua, ou vai atuar?',
        opcoes: [
          'Serviços profissionais B2B',
          'Saúde',
          'Arquitetura, engenharia ou construção',
          'Comunicação, marketing ou educação',
          'Varejo especializado ou alto padrão',
          'Indústria ou distribuição',
          'Outro',
        ],
      },
    ],
  },
  {
    n: '02',
    nome: 'O momento do negócio',
    titulo: 'Onde a empresa está hoje.',
    campos: [
      {
        tipo: 'escolha',
        id: 'frase',
        label: 'Qual frase descreve melhor onde você está hoje?',
        opcoes: [
          'Tenho bom produto e bom atendimento, mas as vendas não acompanham',
          'Cresci, mas o negócio depende demais da minha execução individual',
          'Vendo bem, mas de forma imprevisível',
          'Sinto que estou patinando: muito movimento e pouco avanço',
          'Tenho a ideia e a reputação, mas o negócio ainda não saiu do papel',
          'Está tudo estruturado e previsível, quero apenas otimizar pontos',
        ],
      },
      { tipo: 'longo', id: 'obstaculo', label: 'Qual é hoje o maior obstáculo para o crescimento do seu negócio?' },
      { tipo: 'longo', id: 'adiando', label: 'Qual decisão importante você sabe que precisa tomar e vem adiando?' },
    ],
  },
  {
    n: '03',
    nome: 'Seu comercial hoje',
    titulo: 'Como a venda acontece.',
    campos: [
      {
        tipo: 'escolha',
        id: 'processo',
        label: 'Como você descreveria seu processo de vendas atual?',
        opcoes: [
          'Depende do talento individual de cada vendedor',
          'Vive de indicações e da minha rede pessoal',
          'Temos processo, mas sem previsibilidade de crescimento',
          'Temos processo, metas e previsibilidade consolidados',
        ],
      },
      {
        tipo: 'escolha',
        id: 'contrataria',
        label:
          'Você contrataria uma consultoria hoje sabendo que a estruturação começa pela liderança e pela cultura, e não por scripts prontos?',
        opcoes: [
          'Sim, é exatamente isso que eu procuro',
          'Talvez, preciso entender melhor a profundidade',
          'Não, o que eu quero é técnica rápida para o time',
        ],
      },
    ],
  },
  {
    n: '04',
    nome: 'Sua rotina como líder',
    titulo: 'Como o seu dia se organiza.',
    campos: [
      {
        tipo: 'escolha',
        id: 'rotina',
        label: 'Como você descreveria sua rotina?',
        opcoes: [
          'Apago incêndios o tempo todo',
          'Centralizo decisões para manter controle',
          'Domino o cenário atual, mas me sinto travado para expandir',
          'Rotina organizada, delego com tranquilidade',
        ],
      },
      {
        tipo: 'escolha',
        id: 'antes',
        label: 'Você já contratou consultoria ou treinamento comercial antes?',
        opcoes: [
          'Sim, entregaram um diagnóstico e sumiram. Nada mudou',
          'Sim, ajudou parcialmente',
          'Nunca contratei',
          'Sim, e resolveu. Não preciso de mais nada',
        ],
      },
    ],
  },
  {
    n: '05',
    nome: 'Estrutura e capacidade',
    titulo: 'O tamanho da operação.',
    campos: [
      {
        tipo: 'escolha',
        id: 'faturamento',
        label: 'Se você já tem empresa em operação: faturamento médio mensal',
        opcoes: [
          'Até R$ 30 mil',
          'R$ 30 mil a R$ 50 mil',
          'R$ 50 mil a R$ 200 mil',
          'R$ 200 mil a R$ 1 milhão',
          'Acima de R$ 1 milhão',
          'Ainda não tenho empresa em operação',
        ],
      },
      {
        tipo: 'escolha',
        id: 'renda',
        label: 'Se o negócio ainda está sendo estruturado: sua renda pessoal média mensal hoje',
        opcoes: [
          'Até R$ 30 mil',
          'R$ 30 mil a R$ 60 mil',
          'Acima de R$ 60 mil',
          'Não se aplica, já tenho empresa faturando',
        ],
      },
      {
        tipo: 'escolha',
        id: 'equipe',
        label: 'Quantas pessoas compõem sua equipe hoje?',
        opcoes: ['Apenas eu', '2 a 5 pessoas', '6 a 15 pessoas', 'Mais de 15 pessoas'],
      },
    ],
  },
  {
    n: '06',
    nome: 'Custo e urgência',
    titulo: 'O que já ficou para trás.',
    campos: [
      {
        tipo: 'texto',
        id: 'mesa',
        label:
          'Quanto você estima ter deixado na mesa nos últimos doze meses por falta de uma operação comercial previsível?',
      },
      {
        tipo: 'escolha',
        id: 'prazo',
        label: 'Em quanto tempo você quer que a mudança comece?',
        opcoes: ['Agora, é prioridade', 'Nos próximos 1 a 3 meses', 'Ainda estou pesquisando'],
      },
    ],
  },
];

const compromisso = [
  'Sim, é o tipo de trabalho que eu procuro',
  'Talvez, preciso entender melhor a profundidade',
  'Não é o momento',
];

const total = etapas.length + 1;
---

<Base
  title="Diagnóstico | FEITTO"
  description="Três minutos para saber se faz sentido. Um filtro que funciona nos dois sentidos, lido pessoalmente pela Luana Feitoza."
  bare
>
  <Logo slot="bare-logo" width={132} />

  <!-- abertura: sai de cena assim que o formulário começa -->
  <section class="shell abertura" id="abertura">
    <div class="abertura__left">
      <p class="eyebrow">Diagnóstico de Inteligência Comercial</p>
      <h1 class="abertura__title">
        Três minutos para saber se <em class="key">faz sentido</em>.
      </h1>
      <p class="lede">
        A FEITTO trabalha com um número limitado de empresas por semestre. Este formulário existe
        para a gente entender, com honestidade, se o seu momento e o nosso método se encontram.
      </p>
      <p class="lede">Responda com sinceridade, porque é dela que sai uma leitura que presta.</p>
      <button type="button" class="btn btn--solid abertura__cta" data-comecar>Começar</button>
    </div>

    <aside class="nota">
      <p class="nota__rotulo">Antes de você começar</p>
      <p>
        O que você escrever aqui é lido só por mim e pela nossa equipe. Não vira lista, não vira
        anúncio e não vira exemplo em lugar nenhum.
      </p>
    </aside>
  </section>

  <form class="shell form" id="diagnostico" novalidate>
    <!-- progresso: o mesmo filete de 1px que abre as seções do site -->
    <div class="progresso" data-progresso hidden>
      <div class="progresso__barra">
        <span class="progresso__feito" data-barra></span>
      </div>
      <p class="progresso__texto">
        <span data-passo-num>01</span> <span aria-hidden="true">/</span> {String(total).padStart(2, '0')}
        <span class="progresso__sep" aria-hidden="true">·</span>
        <span data-passo-nome>{etapas[0].nome}</span>
      </p>
    </div>

    {
      etapas.map((etapa, idx) => (
        <fieldset class="etapa" data-etapa={idx} data-nome={etapa.nome} data-num={etapa.n}>
          <legend class="visually-hidden">{`Etapa ${etapa.n}: ${etapa.nome}`}</legend>

          <div class="etapa__head">
            <p class="etapa__rotulo">
              <span class="etapa__num">{etapa.n}</span> {etapa.nome}
            </p>
            <p class="etapa__titulo">{etapa.titulo}</p>
          </div>

          <div class="campos">
            {etapa.campos.map((campo) => (
              <div class:list={['campo', campo.tipo === 'texto' && campo.meia && 'campo--meia']}>
                {campo.tipo === 'texto' && (
                  <>
                    <label for={campo.id}>
                      {campo.label}
                      {campo.obrigatorio && <span class="req" aria-hidden="true"> *</span>}
                    </label>
                    <input
                      id={campo.id}
                      name={campo.id}
                      type={campo.input ?? 'text'}
                      required={campo.obrigatorio}
                      autocomplete={
                        campo.id === 'nome' ? 'name'
                        : campo.id === 'email' ? 'email'
                        : campo.id === 'whatsapp' ? 'tel'
                        : 'off'
                      }
                    />
                  </>
                )}

                {campo.tipo === 'longo' && (
                  <>
                    <label for={campo.id}>{campo.label}</label>
                    <textarea id={campo.id} name={campo.id} rows="3" />
                  </>
                )}

                {campo.tipo === 'escolha' && (
                  <fieldset class="escolha">
                    <legend>
                      {campo.label}
                      {campo.obrigatorio && <span class="req" aria-hidden="true"> *</span>}
                    </legend>
                    <div class="opcoes">
                      {campo.opcoes.map((opcao, j) => (
                        <label class="opcao" for={`${campo.id}-${j}`}>
                          <input
                            id={`${campo.id}-${j}`}
                            type="radio"
                            name={campo.id}
                            value={opcao}
                            required={campo.obrigatorio && j === 0}
                          />
                          <span>{opcao}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                )}
              </div>
            ))}
          </div>
        </fieldset>
      ))
    }

    <!-- última etapa: o filtro -->
    <fieldset class="etapa etapa--final" data-etapa={etapas.length} data-nome="Compromisso" data-num="07">
      <legend class="visually-hidden">Etapa 07: Compromisso</legend>

      <div class="etapa__head">
        <p class="etapa__rotulo"><span class="etapa__num">07</span> Compromisso</p>
        <p class="etapa__titulo">A última, e a mais direta.</p>
      </div>

      <div class="campos">
        <div class="campo">
          <fieldset class="escolha">
            <legend class="final__pergunta">
              O nosso trabalho mexe primeiro em como você decide, e isso pede a sua liderança dentro
              da sala. O ciclo e o investimento saem depois do diagnóstico, quando já sabemos o que o
              seu caso pede. Você está pronto para esse nível de envolvimento?
            </legend>
            <div class="opcoes">
              {
                compromisso.map((opcao, j) => (
                  <label class="opcao opcao--final" for={`compromisso-${j}`}>
                    <input id={`compromisso-${j}`} type="radio" name="compromisso" value={opcao} required={j === 0} />
                    <span>{opcao}</span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        <div class="lgpd">
          <input id="lgpd" name="lgpd" type="checkbox" required />
          <label for="lgpd">
            Autorizo a FEITTO a tratar os dados acima para analisar o meu caso e entrar em contato,
            conforme a <a href="/politica-de-privacidade">Política de Privacidade</a>. Posso pedir a
            exclusão a qualquer momento.
          </label>
        </div>
      </div>
    </fieldset>

    <p class="erro" id="form-erro" role="alert" hidden></p>

    <!-- controles: só aparecem quando o passo a passo está ativo -->
    <div class="controles" data-controles hidden>
      <button type="button" class="voltar" data-voltar>
        <span aria-hidden="true">←</span> Voltar
      </button>
      <button type="button" class="btn btn--solid" data-avancar>Continuar</button>
      <button type="submit" class="btn btn--solid" data-enviar hidden>Enviar minhas respostas</button>
    </div>

    <!-- sem JavaScript o formulário é uma página só e envia direto -->
    <noscript>
      <button type="submit" class="btn btn--solid enviar-noscript">Enviar minhas respostas</button>
    </noscript>
  </form>

  <section class="shell section depois" data-depois>
    <div class="rule">
      <span class="rule__num" aria-hidden="true">→</span>
      <span class="rule__label">O que acontece depois</span>
    </div>

    <ol class="passos">
      <li class="passo">
        <span class="passo__num">01</span>
        <p>Eu leio pessoalmente. Aqui não tem resposta automática.</p>
      </li>
      <li class="passo">
        <span class="passo__num">02</span>
        <p>
          Havendo encaixe, você recebe um contato pelo WhatsApp em até dois dias úteis, já com uma
          primeira leitura do seu caso.
        </p>
      </li>
      <li class="passo">
        <span class="passo__num">03</span>
        <p>
          Se não houver, eu te falo isso com clareza e, quando der, aponto um caminho que sirva para
          o seu momento.
        </p>
      </li>
    </ol>
  </section>

  <section class="confirma" id="confirmacao" hidden tabindex="-1">
    <div class="shell">
      <div class="confirma__grid">
        <h2 class="confirma__title">Recebemos suas respostas.</h2>
        <div class="confirma__texto">
          <p>
            Cada diagnóstico é lido pessoalmente, então não espere um retorno automático. Havendo
            encaixe entre o seu momento e o nosso método, a gente procura você pelo WhatsApp que
            ficou aí em cima.
          </p>
          <p class="confirma__forte">Obrigada pela sinceridade. É dela que a clareza começa.</p>
          <a href="/" class="link-rule confirma__voltar">
            Voltar ao início <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .abertura {
    display: grid;
    gap: clamp(2rem, 5vw, 7.5rem);
    padding-block-start: clamp(3.5rem, 6vw, 5.75rem);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .abertura {
      grid-template-columns: minmax(0, 43.75rem) minmax(0, 1fr);
    }
  }
  .abertura[hidden] {
    display: none;
  }
  .abertura__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.375rem;
  }
  .abertura__title {
    margin-block: 2rem 0.75rem;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.028em;
  }
  .abertura__cta {
    margin-block-start: 1.375rem;
  }

  .nota {
    border-inline-start: 2px solid var(--drift);
    padding-inline-start: 2.125rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--coffee);
  }
  @media (min-width: 62rem) {
    .nota {
      margin-block-start: 3.75rem;
    }
  }
  .nota__rotulo {
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--drift-ink);
  }

  /* ------------------------------------------------------------------ *
   * formulário
   * ------------------------------------------------------------------ */
  .form {
    padding-block-start: clamp(2.5rem, 5vw, 4rem);
  }

  .progresso[hidden] {
    display: none;
  }
  .progresso {
    max-width: 44rem;
  }
  .progresso__barra {
    height: 1px;
    background: var(--silver);
  }
  .progresso__feito {
    display: block;
    height: 1px;
    width: 0;
    background: var(--ink);
    transition: width 620ms var(--ease);
  }
  .progresso__texto {
    margin-block-start: 1.125rem;
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--drift);
  }
  .progresso__sep {
    margin-inline: 0.5rem;
  }

  .etapa {
    margin: 0;
    padding: 0;
    border: 0;
    max-width: 44rem;
  }
  .etapa[hidden] {
    display: none;
  }
  /* quando o passo a passo está ativo, cada etapa entra como os blocos do site */
  .is-stepped .etapa:not([hidden]) {
    animation: entra var(--dur) var(--ease) both;
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-stepped .etapa:not([hidden]) {
      animation: none;
    }
    .progresso__feito {
      transition: none;
    }
  }

  .etapa__head {
    margin-block: clamp(2.5rem, 5vw, 3.75rem) clamp(2rem, 4vw, 3rem);
  }
  /* sem o passo a passo, cada etapa se anuncia com a régua de dossiê */
  .etapa:not(:first-of-type) .etapa__head {
    border-block-start: 1px solid var(--silver);
    padding-block-start: 2.5rem;
  }
  .is-stepped .etapa .etapa__head {
    border: 0;
    padding-block-start: 0;
    margin-block-start: clamp(2rem, 4vw, 2.75rem);
  }

  .etapa__rotulo {
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--coffee);
  }
  .is-stepped .etapa__rotulo {
    display: none;
  }
  .etapa__num {
    color: var(--drift);
    margin-inline-end: 0.75rem;
  }
  .etapa__titulo {
    margin-block-start: 1rem;
    font-family: var(--display);
    font-weight: 200;
    font-size: clamp(1.75rem, 3.6vw, 2.625rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  /* uma coluna, com respiro: é o que deixa o formulário leve de responder */
  .campos {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.25rem);
  }
  @media (min-width: 48rem) {
    .campos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .campo {
      grid-column: 1 / -1;
    }
    .campo--meia {
      grid-column: span 1;
    }
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  .campo > label {
    font-size: 0.9375rem;
    color: var(--coffee);
  }
  .req {
    color: var(--drift);
  }

  .campo input[type='text'],
  .campo input[type='tel'],
  .campo input[type='email'] {
    min-height: 44px;
    padding: 0.8125rem 0;
    font-family: var(--sans);
    font-size: 1.1875rem;
    font-weight: 300;
    color: var(--ink);
    background: none;
    border: 0;
    border-block-end: 1px solid var(--silver);
    border-radius: 0;
    transition: border-color 200ms var(--ease);
  }
  .campo input:focus {
    border-color: var(--ink);
  }
  .campo input:not(:placeholder-shown):valid {
    border-color: var(--drift);
  }

  .campo textarea {
    padding: 1.125rem 1.25rem;
    font-family: var(--sans);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink);
    background: none;
    border: 1px solid var(--silver);
    border-radius: 0;
    resize: vertical;
    transition: border-color 200ms var(--ease);
  }
  .campo textarea:focus {
    border-color: var(--ink);
  }

  .escolha {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .escolha > legend {
    padding: 0;
    margin-block-end: 1.125rem;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink);
  }

  .opcoes {
    display: flex;
    flex-direction: column;
  }

  /* a opção inteira é alvo de toque, e a marca de seleção é um filete */
  .opcao {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    min-height: 44px;
    padding: 0.9375rem 0.875rem 0.9375rem 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--coffee);
    cursor: pointer;
    border-block-end: 1px solid var(--hairline-soft);
    transition: color 180ms var(--ease), border-color 180ms var(--ease);
  }
  .opcao:hover {
    color: var(--ink);
    border-color: var(--silver);
  }
  .opcao:has(input:checked) {
    color: var(--ink);
    border-color: var(--ink);
  }
  .opcao input {
    flex: 0 0 auto;
    width: 0.9375rem;
    height: 0.9375rem;
    margin-block-start: 0.3125rem;
    accent-color: var(--ink);
    cursor: pointer;
  }

  .final__pergunta {
    font-size: clamp(1.0625rem, 1.8vw, 1.3125rem) !important;
    line-height: 1.55 !important;
  }
  .opcao--final {
    padding-block: 1.125rem;
  }

  .lgpd {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    grid-column: 1 / -1;
  }
  .lgpd input {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    margin-block-start: 0.3125rem;
    accent-color: var(--ink);
    cursor: pointer;
  }
  .lgpd label {
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--coffee);
    cursor: pointer;
  }
  .lgpd a {
    color: var(--ink);
    text-decoration: none;
    border-block-end: 1px solid var(--drift);
  }

  .erro {
    max-width: 44rem;
    margin-block-start: 2rem;
    border-inline-start: 2px solid var(--ink);
    padding-inline-start: 1.125rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--coffee);
  }
  .erro[hidden] {
    display: none;
  }

  .controles {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 44rem;
    margin-block-start: clamp(2.5rem, 4vw, 3.5rem);
    border-block-start: 1px solid var(--hairline);
    padding-block-start: 1.75rem;
  }
  .controles[hidden] {
    display: none;
  }
  .voltar {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    padding: 0;
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--drift-ink);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 200ms var(--ease);
  }
  .voltar:hover {
    color: var(--ink);
  }
  .voltar[hidden] {
    visibility: hidden;
  }
  .controles .btn {
    margin-inline-start: auto;
  }
  .controles .btn[hidden] {
    display: none;
  }

  .enviar-noscript {
    margin-block-start: 2.5rem;
  }

  /* o que acontece depois */
  .depois[hidden] {
    display: none;
  }
  .passos {
    display: grid;
    gap: 2rem 0;
    margin: clamp(2rem, 3vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 62rem) {
    .passos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .passo {
      padding-inline-end: 4rem;
    }
    .passo + .passo {
      border-inline-start: 1px solid var(--hairline);
      padding-inline-start: 4rem;
    }
  }
  .passo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .passo__num {
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    color: var(--drift);
  }
  .passo p {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.7;
  }

  /* confirmação */
  .confirma {
    margin-block-start: clamp(4rem, 7vw, 6.5rem);
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--ink);
    color: var(--silver);
  }
  .confirma[hidden] {
    display: none;
  }
  .confirma__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 7.5rem);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .confirma__grid {
      grid-template-columns: minmax(0, 38.75rem) minmax(0, 1fr);
    }
  }
  .confirma__title {
    font-size: clamp(2.125rem, 4.5vw, 3.125rem);
    color: var(--alyssum);
  }
  .confirma__texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .confirma__texto p {
    line-height: 1.8;
  }
  .confirma__forte {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    color: var(--alyssum);
  }
  .confirma__voltar {
    color: var(--alyssum);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#diagnostico')!;
  const abertura = document.querySelector<HTMLElement>('#abertura')!;
  const comecar = document.querySelector<HTMLButtonElement>('[data-comecar]')!;
  const etapas = [...form.querySelectorAll<HTMLFieldSetElement>('.etapa')];
  const progresso = form.querySelector<HTMLElement>('[data-progresso]')!;
  const barra = form.querySelector<HTMLElement>('[data-barra]')!;
  const passoNum = form.querySelector<HTMLElement>('[data-passo-num]')!;
  const passoNome = form.querySelector<HTMLElement>('[data-passo-nome]')!;
  const controles = form.querySelector<HTMLElement>('[data-controles]')!;
  const btnVoltar = form.querySelector<HTMLButtonElement>('[data-voltar]')!;
  const btnAvancar = form.querySelector<HTMLButtonElement>('[data-avancar]')!;
  const btnEnviar = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
  const erro = document.querySelector<HTMLElement>('#form-erro')!;
  const depois = document.querySelector<HTMLElement>('[data-depois]')!;
  const confirmacao = document.querySelector<HTMLElement>('#confirmacao')!;

  /**
   * [PENDENTE] Endpoint de recebimento. Enquanto estiver vazio, o envio segue
   * o fluxo completo na tela mas nada sai do navegador — é o que permite
   * testar a experiência antes do CRM estar ligado.
   */
  const ENDPOINT = '';

  const ultima = etapas.length - 1;
  let atual = 0;

  // a partir daqui o formulário é uma coisa só na tela: um passo por vez
  form.classList.add('is-stepped');
  progresso.hidden = false;
  controles.hidden = false;
  mostrar(0, { rolar: false });

  function mostrar(indice: number, opcoes: { rolar?: boolean } = {}) {
    atual = Math.max(0, Math.min(indice, ultima));

    etapas.forEach((etapa, i) => {
      etapa.hidden = i !== atual;
      // campo escondido não entra na validação nem no foco por Tab
      etapa.disabled = i !== atual;
    });

    const etapa = etapas[atual];
    passoNum.textContent = etapa.dataset.num ?? '';
    passoNome.textContent = etapa.dataset.nome ?? '';
    barra.style.width = `${((atual + 1) / etapas.length) * 100}%`;

    btnVoltar.hidden = atual === 0;
    btnAvancar.hidden = atual === ultima;
    btnEnviar.hidden = atual !== ultima;
    erro.hidden = true;

    if (opcoes.rolar !== false) {
      progresso.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    etapa.querySelector<HTMLElement>('input, textarea')?.focus({ preventScroll: true });
  }

  /** Valida só a etapa visível: as outras estão disabled e ficam de fora. */
  function etapaValida(): boolean {
    const campos = [...etapas[atual].querySelectorAll<HTMLInputElement>('input, textarea')];
    for (const campo of campos) {
      if (!campo.checkValidity()) {
        campo.reportValidity();
        campo.focus({ preventScroll: true });
        return false;
      }
    }
    return true;
  }

  comecar.addEventListener('click', () => {
    abertura.hidden = true;
    depois.hidden = true;
    mostrar(0);
  });

  btnAvancar.addEventListener('click', () => {
    if (etapaValida()) mostrar(atual + 1);
  });

  btnVoltar.addEventListener('click', () => mostrar(atual - 1));

  // Enter avança em vez de enviar, exceto na última etapa
  form.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter') return;
    const alvo = event.target as HTMLElement;
    if (alvo.tagName === 'TEXTAREA') return;
    if (atual !== ultima) {
      event.preventDefault();
      if (etapaValida()) mostrar(atual + 1);
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    erro.hidden = true;
    if (!etapaValida()) return;

    btnEnviar.disabled = true;
    btnEnviar.textContent = 'Enviando…';

    // as etapas estão disabled, então FormData sozinho viria vazia
    for (const etapa of etapas) etapa.disabled = false;
    const dados = Object.fromEntries(new FormData(form).entries());
    for (const [i, etapa] of etapas.entries()) etapa.disabled = i !== atual;

    try {
      if (ENDPOINT) {
        const resposta = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(dados),
        });
        if (!resposta.ok) throw new Error(String(resposta.status));
      } else {
        console.info('[diagnóstico] endpoint ainda não configurado. Respostas:', dados);
      }

      form.hidden = true;
      abertura.hidden = true;
      depois.hidden = true;
      confirmacao.hidden = false;
      confirmacao.scrollIntoView({ behavior: 'smooth', block: 'start' });
      confirmacao.focus({ preventScroll: true });
    } catch {
      btnEnviar.disabled = false;
      btnEnviar.textContent = 'Enviar minhas respostas';
      erro.hidden = false;
      erro.textContent =
        'Não consegui enviar agora. Tente de novo em instantes ou me escreva em contato@feitto.com.br que eu leio do mesmo jeito.';
    }
  });
</script>
