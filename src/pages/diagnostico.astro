---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';

/**
 * Filtro de entrada, em etapas.
 * Nem valor nem prazo aparecem aqui: a capacidade de investir é lida pelos
 * blocos 05 e 06, e o compromisso pelo bloco 07.
 *
 * Sem JavaScript todas as etapas ficam visíveis e o formulário funciona como
 * uma página só — o passo a passo é melhoria progressiva, nunca requisito.
 */

type Campo =
  | {
      tipo: 'texto';
      id: string;
      label: string;
      input?: 'tel' | 'email' | 'text';
      obrigatorio?: boolean;
      meia?: boolean;
      ajuda?: string;
      mostrarSe?: Condicao;
    }
  | { tipo: 'longo'; id: string; label: string; ajuda?: string; mostrarSe?: Condicao }
  | {
      tipo: 'escolha';
      id: string;
      label: string;
      opcoes: string[];
      obrigatorio?: boolean;
      ajuda?: string;
      mostrarSe?: Condicao;
    };

/** Campo que só aparece quando outro campo tem determinado valor. */
interface Condicao {
  campo: string;
  valor: string;
}

interface Etapa {
  n: string;
  nome: string;
  titulo: string;
  campos: Campo[];
}

const EM_OPERACAO = 'Tenho uma empresa em operação, com faturamento recorrente';
const ESTRUTURANDO = 'Estou estruturando um negócio novo ou em transição de carreira';

/**
 * Ordem pensada para a conversão, e não para a conveniência do cadastro:
 * a pessoa se reconhece, descreve o que trava, se qualifica e só então se
 * identifica. Contato é a última etapa, quando já houve investimento.
 *
 * A primeira pergunta bifurca o formulário: quem opera responde faturamento,
 * quem está fundando responde renda pessoal. Ninguém vê as duas.
 */
const etapas: Etapa[] = [
  {
    n: '01',
    nome: 'Seu momento',
    titulo: 'Vamos começar por onde você está.',
    campos: [
      {
        tipo: 'escolha',
        id: 'momento',
        label: 'Qual é o seu momento?',
        opcoes: [EM_OPERACAO, ESTRUTURANDO],
        obrigatorio: true,
      },
      {
        tipo: 'escolha',
        id: 'frase',
        label: 'Qual frase descreve melhor onde você está hoje?',
        opcoes: [
          'Tenho bom produto e bom atendimento, mas as vendas não acompanham',
          'Cresci, mas o negócio depende demais da minha execução individual',
          'Vendo bem, mas de forma imprevisível',
          'Sinto que estou patinando: muito movimento e pouco avanço',
          'Tenho a ideia e a reputação, mas o negócio ainda não saiu do papel',
          'Está tudo estruturado e previsível, quero apenas otimizar pontos',
        ],
        obrigatorio: true,
      },
    ],
  },
  {
    n: '02',
    nome: 'O que trava',
    titulo: 'O que está travando.',
    campos: [
      {
        tipo: 'longo',
        id: 'obstaculo',
        label: 'Qual é hoje o maior obstáculo para o crescimento do seu negócio?',
        ajuda: 'Escreva do seu jeito. É aqui que a leitura começa.',
      },
      {
        tipo: 'longo',
        id: 'adiando',
        label: 'Qual decisão importante você sabe que precisa tomar e vem adiando?',
      },
    ],
  },
  {
    n: '03',
    nome: 'Como você vende',
    titulo: 'Como a venda acontece hoje.',
    campos: [
      {
        tipo: 'escolha',
        id: 'processo',
        label: 'Como você descreveria seu processo de vendas atual?',
        opcoes: [
          'Depende do talento individual de cada vendedor',
          'Vive de indicações e da minha rede pessoal',
          'Temos processo, mas sem previsibilidade de crescimento',
          'Temos processo, metas e previsibilidade consolidados',
        ],
        obrigatorio: true,
      },
      {
        tipo: 'escolha',
        id: 'antes',
        label: 'Você já contratou consultoria ou treinamento comercial antes?',
        opcoes: [
          'Sim, entregaram um diagnóstico e sumiram. Nada mudou',
          'Sim, ajudou parcialmente',
          'Nunca contratei',
          'Sim, e resolveu. Não preciso de mais nada',
        ],
      },
    ],
  },
  {
    n: '04',
    nome: 'Como você lidera',
    titulo: 'Como você lidera.',
    campos: [
      {
        tipo: 'escolha',
        id: 'rotina',
        label: 'Como você descreveria sua rotina?',
        opcoes: [
          'Apago incêndios o tempo todo',
          'Centralizo decisões para manter controle',
          'Domino o cenário atual, mas me sinto travado para expandir',
          'Rotina organizada, delego com tranquilidade',
        ],
        obrigatorio: true,
      },
      {
        tipo: 'escolha',
        id: 'contrataria',
        label:
          'Você contrataria uma consultoria hoje sabendo que a estruturação começa pela liderança e pela cultura, e não por scripts prontos?',
        opcoes: [
          'Sim, é exatamente isso que eu procuro',
          'Talvez, preciso entender melhor a profundidade',
          'Não, o que eu quero é técnica rápida para o time',
        ],
        obrigatorio: true,
      },
    ],
  },
  {
    n: '05',
    nome: 'A operação',
    titulo: 'O tamanho da operação.',
    campos: [
      {
        tipo: 'escolha',
        id: 'faturamento',
        label: 'Faturamento médio mensal da empresa',
        opcoes: [
          'Até R$ 30 mil',
          'R$ 30 mil a R$ 50 mil',
          'R$ 50 mil a R$ 200 mil',
          'R$ 200 mil a R$ 1 milhão',
          'Acima de R$ 1 milhão',
        ],
        obrigatorio: true,
        mostrarSe: { campo: 'momento', valor: EM_OPERACAO },
      },
      {
        tipo: 'escolha',
        id: 'renda',
        label: 'Sua renda pessoal média mensal hoje',
        ajuda: 'O negócio ainda está sendo estruturado, então é a sua renda que dá a referência.',
        opcoes: ['Até R$ 30 mil', 'R$ 30 mil a R$ 60 mil', 'Acima de R$ 60 mil'],
        obrigatorio: true,
        mostrarSe: { campo: 'momento', valor: ESTRUTURANDO },
      },
      {
        tipo: 'escolha',
        id: 'equipe',
        label: 'Quantas pessoas compõem sua equipe hoje?',
        opcoes: ['Apenas eu', '2 a 5 pessoas', '6 a 15 pessoas', 'Mais de 15 pessoas'],
        obrigatorio: true,
      },
      {
        tipo: 'escolha',
        id: 'segmento',
        label: 'Em que segmento você atua, ou vai atuar?',
        opcoes: [
          'Serviços profissionais B2B',
          'Saúde',
          'Arquitetura, engenharia ou construção',
          'Comunicação, marketing ou educação',
          'Varejo especializado ou alto padrão',
          'Indústria ou distribuição',
          'Outro',
        ],
        obrigatorio: true,
      },
      {
        tipo: 'texto',
        id: 'segmentoOutro',
        label: 'Qual?',
        mostrarSe: { campo: 'segmento', valor: 'Outro' },
      },
    ],
  },
  {
    n: '06',
    nome: 'O custo de esperar',
    titulo: 'O custo de esperar.',
    campos: [
      {
        tipo: 'texto',
        id: 'mesa',
        label:
          'Quanto você estima ter deixado na mesa nos últimos doze meses por falta de uma operação comercial previsível?',
        ajuda: 'Um número aproximado basta. Ninguém vai cobrar exatidão.',
      },
      {
        tipo: 'escolha',
        id: 'prazo',
        label: 'Em quanto tempo você quer que a mudança comece?',
        opcoes: ['Agora, é prioridade', 'Nos próximos 1 a 3 meses', 'Ainda estou pesquisando'],
        obrigatorio: true,
      },
    ],
  },
  {
    n: '07',
    nome: 'Compromisso',
    titulo: 'A mais direta de todas.',
    campos: [
      {
        tipo: 'escolha',
        id: 'compromisso',
        label:
          'O nosso trabalho mexe primeiro em como você decide, e isso pede a sua liderança dentro da sala. O ciclo e o investimento saem depois do diagnóstico, quando já sabemos o que o seu caso pede. Você está pronto para esse nível de envolvimento?',
        opcoes: [
          'Sim, é o tipo de trabalho que eu procuro',
          'Talvez, preciso entender melhor a profundidade',
          'Não é o momento',
        ],
        obrigatorio: true,
      },
    ],
  },
  {
    n: '08',
    nome: 'Por onde eu te respondo',
    titulo: 'Por onde eu te respondo.',
    campos: [
      { tipo: 'texto', id: 'nome', label: 'Nome completo', obrigatorio: true },
      { tipo: 'texto', id: 'whatsapp', label: 'WhatsApp', input: 'tel', obrigatorio: true, meia: true },
      { tipo: 'texto', id: 'email', label: 'E-mail', input: 'email', obrigatorio: true, meia: true },
      { tipo: 'texto', id: 'empresa', label: 'Empresa e site ou Instagram' },
      {
        tipo: 'escolha',
        id: 'papel',
        label: 'Qual o seu papel na empresa?',
        opcoes: [
          'Sou fundador(a) ou sócio(a) e decido sobre investimentos',
          'Sou da liderança e influencio, mas não decido sozinho',
          'Sou de outra área ou estou pesquisando para alguém',
        ],
        obrigatorio: true,
      },
      {
        tipo: 'escolha',
        id: 'chegada',
        label: 'Como você chegou até a FEITTO?',
        opcoes: ['Indicação de alguém', 'Instagram', 'LinkedIn', 'Busca no Google', 'Outro'],
        obrigatorio: true,
      },
      {
        tipo: 'texto',
        id: 'indicou',
        label: 'De quem?',
        mostrarSe: { campo: 'chegada', valor: 'Indicação de alguém' },
      },
    ],
  },
];

const total = etapas.length;
---

<Base
  title="Diagnóstico | FEITTO"
  description="Três minutos para saber se faz sentido. Um filtro que funciona nos dois sentidos, lido pessoalmente pela Luana Feitoza."
  bare
>
  <Logo slot="bare-logo" width={132} />

  <!-- abertura: sai de cena assim que o formulário começa -->
  <section class="shell abertura" id="abertura">
    <div class="abertura__left">
      <p class="eyebrow">Diagnóstico de Inteligência Comercial</p>
      <h1 class="abertura__title">
        Três minutos para saber se <em class="key">faz sentido</em>.
      </h1>
      <p class="lede">
        A FEITTO trabalha com um número limitado de empresas por semestre. Este formulário existe
        para a gente entender, com honestidade, se o seu momento e o nosso método se encontram.
      </p>
      <p class="lede">Responda com sinceridade, porque é dela que sai uma leitura que presta.</p>
      <button type="button" class="btn btn--solid abertura__cta" data-comecar>Começar</button>
    </div>

    <aside class="nota">
      <p class="nota__rotulo">Antes de você começar</p>
      <p>
        O que você escrever aqui é lido só por mim e pela nossa equipe. Não vira lista, não vira
        anúncio e não vira exemplo em lugar nenhum.
      </p>
    </aside>
  </section>

  <form class="shell form" id="diagnostico" novalidate>
    <!-- progresso: o mesmo filete de 1px que abre as seções do site -->
    <div class="progresso" data-progresso hidden>
      <div class="progresso__barra">
        <span class="progresso__feito" data-barra></span>
      </div>
      <p class="progresso__texto">
        <span data-passo-num>01</span> <span aria-hidden="true">/</span> {String(total).padStart(2, '0')}
        <span class="progresso__sep" aria-hidden="true">·</span>
        <span data-passo-nome>{etapas[0].nome}</span>
      </p>
    </div>

    {
      etapas.map((etapa, idx) => (
        <fieldset class="etapa" data-etapa={idx} data-nome={etapa.nome} data-num={etapa.n}>
          <legend class="visually-hidden">{`Etapa ${etapa.n}: ${etapa.nome}`}</legend>

          <div class="etapa__head">
            <p class="etapa__rotulo">
              <span class="etapa__num">{etapa.n}</span> {etapa.nome}
            </p>
            <p class="etapa__titulo">{etapa.titulo}</p>
          </div>

          <div class="campos">
            {etapa.campos.map((campo) => (
              <div
                class:list={['campo', campo.tipo === 'texto' && campo.meia && 'campo--meia']}
                data-se-campo={campo.mostrarSe?.campo}
                data-se-valor={campo.mostrarSe?.valor}
                data-req={campo.tipo !== 'longo' && campo.obrigatorio ? 'sim' : undefined}
              >
                {campo.tipo === 'texto' && (
                  <>
                    <label for={campo.id}>
                      {campo.label}
                      {campo.obrigatorio && <span class="req" aria-hidden="true"> *</span>}
                    </label>
                    {campo.ajuda && <p class="campo__ajuda">{campo.ajuda}</p>}
                    <input
                      id={campo.id}
                      name={campo.id}
                      type={campo.input ?? 'text'}
                      required={campo.obrigatorio && !campo.mostrarSe}
                      autocomplete={
                        campo.id === 'nome' ? 'name'
                        : campo.id === 'email' ? 'email'
                        : campo.id === 'whatsapp' ? 'tel'
                        : 'off'
                      }
                    />
                  </>
                )}

                {campo.tipo === 'longo' && (
                  <>
                    <label for={campo.id}>{campo.label}</label>
                    {campo.ajuda && <p class="campo__ajuda">{campo.ajuda}</p>}
                    <textarea id={campo.id} name={campo.id} rows="3" />
                  </>
                )}

                {campo.tipo === 'escolha' && (
                  <fieldset class="escolha">
                    <legend>
                      {campo.label}
                      {campo.obrigatorio && <span class="req" aria-hidden="true"> *</span>}
                    </legend>
                    {campo.ajuda && <p class="campo__ajuda campo__ajuda--solta">{campo.ajuda}</p>}
                    <div class="opcoes">
                      {campo.opcoes.map((opcao, j) => (
                        <label class="opcao" for={`${campo.id}-${j}`}>
                          <input
                            id={`${campo.id}-${j}`}
                            type="radio"
                            name={campo.id}
                            value={opcao}
                            required={campo.obrigatorio && !campo.mostrarSe && j === 0}
                          />
                          <span>{opcao}</span>
                        </label>
                      ))}
                    </div>
                  </fieldset>
                )}
              </div>
            ))}

            {/* o consentimento fecha a última etapa, ao lado dos dados de contato */}
            {idx === etapas.length - 1 && (
              <div class="lgpd">
                <input id="lgpd" name="lgpd" type="checkbox" required />
                <label for="lgpd">
                  Autorizo a FEITTO a tratar os dados acima para analisar o meu caso e entrar em
                  contato, conforme a <a href="/politica-de-privacidade">Política de Privacidade</a>.
                  Posso pedir a exclusão a qualquer momento.
                </label>
              </div>
            )}
          </div>
        </fieldset>
      ))
    }

    {/* armadilha: invisível para gente, irresistível para robô */}
    <div class="armadilha" aria-hidden="true">
      <label for="sobrenome">Não preencha este campo</label>
      <input id="sobrenome" name="sobrenome" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p class="erro" id="form-erro" role="alert" hidden></p>

    <!-- controles: só aparecem quando o passo a passo está ativo -->
    <div class="controles" data-controles hidden>
      <button type="button" class="voltar" data-voltar>
        <span aria-hidden="true">←</span> Voltar
      </button>
      <button type="button" class="btn btn--solid" data-avancar>Continuar</button>
      <button type="submit" class="btn btn--solid" data-enviar hidden>Enviar minhas respostas</button>
    </div>

    <!-- sem JavaScript o formulário é uma página só e envia direto -->
    <noscript>
      <button type="submit" class="btn btn--solid enviar-noscript">Enviar minhas respostas</button>
    </noscript>
  </form>

  <section class="shell section depois" data-depois>
    <div class="rule">
      <span class="rule__num" aria-hidden="true">→</span>
      <span class="rule__label">O que acontece depois</span>
    </div>

    <ol class="passos">
      <li class="passo">
        <span class="passo__num">01</span>
        <p>Eu leio pessoalmente. Aqui não tem resposta automática.</p>
      </li>
      <li class="passo">
        <span class="passo__num">02</span>
        <p>
          Havendo encaixe, você recebe um contato pelo WhatsApp em até dois dias úteis, já com uma
          primeira leitura do seu caso.
        </p>
      </li>
      <li class="passo">
        <span class="passo__num">03</span>
        <p>
          Se não houver, eu te falo isso com clareza e, quando der, aponto um caminho que sirva para
          o seu momento.
        </p>
      </li>
    </ol>
  </section>

  <section class="confirma" id="confirmacao" hidden tabindex="-1">
    <div class="shell">
      <div class="confirma__grid">
        <h2 class="confirma__title">Recebemos suas respostas.</h2>
        <div class="confirma__texto">
          <p>
            Cada diagnóstico é lido pessoalmente, então não espere um retorno automático. Havendo
            encaixe entre o seu momento e o nosso método, a gente procura você pelo WhatsApp que
            ficou aí em cima.
          </p>
          <p class="confirma__forte">Obrigada pela sinceridade. É dela que a clareza começa.</p>
          <a href="/" class="link-rule confirma__voltar">
            Voltar ao início <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .abertura {
    display: grid;
    gap: clamp(2rem, 5vw, 7.5rem);
    padding-block-start: clamp(3.5rem, 6vw, 5.75rem);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .abertura {
      grid-template-columns: minmax(0, 43.75rem) minmax(0, 1fr);
    }
  }
  .abertura[hidden] {
    display: none;
  }
  .abertura__left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.375rem;
  }
  .abertura__title {
    margin-block: 2rem 0.75rem;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    line-height: 1.06;
    letter-spacing: -0.028em;
  }
  .abertura__cta {
    margin-block-start: 1.375rem;
  }

  .nota {
    border-inline-start: 2px solid var(--drift);
    padding-inline-start: 2.125rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--coffee);
  }
  @media (min-width: 62rem) {
    .nota {
      margin-block-start: 3.75rem;
    }
  }
  .nota__rotulo {
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--drift-ink);
  }

  /* ------------------------------------------------------------------ *
   * formulário
   * ------------------------------------------------------------------ */
  .form {
    padding-block-start: clamp(2.5rem, 5vw, 4rem);
  }

  .progresso[hidden] {
    display: none;
  }
  .progresso {
    max-width: 44rem;
  }
  .progresso__barra {
    height: 1px;
    background: var(--silver);
  }
  .progresso__feito {
    display: block;
    height: 1px;
    width: 0;
    background: var(--ink);
    transition: width 620ms var(--ease);
  }
  .progresso__texto {
    margin-block-start: 1.125rem;
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--drift);
  }
  .progresso__sep {
    margin-inline: 0.5rem;
  }

  .etapa {
    margin: 0;
    padding: 0;
    border: 0;
    max-width: 44rem;
  }
  .etapa[hidden] {
    display: none;
  }
  /* quando o passo a passo está ativo, cada etapa entra como os blocos do site */
  .is-stepped .etapa:not([hidden]) {
    animation: entra var(--dur) var(--ease) both;
  }
  @keyframes entra {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-stepped .etapa:not([hidden]) {
      animation: none;
    }
    .progresso__feito {
      transition: none;
    }
  }

  .etapa__head {
    margin-block: clamp(2.5rem, 5vw, 3.75rem) clamp(2rem, 4vw, 3rem);
  }
  /* sem o passo a passo, cada etapa se anuncia com a régua de dossiê */
  .etapa:not(:first-of-type) .etapa__head {
    border-block-start: 1px solid var(--silver);
    padding-block-start: 2.5rem;
  }
  .is-stepped .etapa .etapa__head {
    border: 0;
    padding-block-start: 0;
    margin-block-start: clamp(2rem, 4vw, 2.75rem);
  }

  .etapa__rotulo {
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--coffee);
  }
  .is-stepped .etapa__rotulo {
    display: none;
  }
  .etapa__num {
    color: var(--drift);
    margin-inline-end: 0.75rem;
  }
  .etapa__titulo {
    margin-block-start: 1rem;
    font-family: var(--display);
    font-weight: 200;
    font-size: clamp(1.75rem, 3.6vw, 2.625rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  /* uma coluna, com respiro: é o que deixa o formulário leve de responder */
  .campos {
    display: grid;
    gap: clamp(2.25rem, 4vw, 3.25rem);
  }
  @media (min-width: 48rem) {
    .campos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .campo {
      grid-column: 1 / -1;
    }
    .campo--meia {
      grid-column: span 1;
    }
  }

  .campo {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }
  /* sem JavaScript todo campo condicional aparece, e nenhum é obrigatório.
     Com JavaScript o CSS os esconde antes da primeira pintura, e o script
     revela apenas o que a resposta anterior pedir. */
  :global(html:not(.no-js)) .campo[data-se-campo]:not([data-ativo]) {
    display: none;
  }
  .campo > label {
    font-size: 0.9375rem;
    color: var(--coffee);
  }
  .req {
    color: var(--drift);
  }

  /* uma linha de contexto onde a pergunta sozinha deixaria dúvida */
  .campo__ajuda {
    margin-block-start: -0.375rem;
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--drift-ink);
  }
  .campo__ajuda--solta {
    margin-block: -0.5rem 1rem;
  }

  .campo input[type='text'],
  .campo input[type='tel'],
  .campo input[type='email'] {
    min-height: 44px;
    padding: 0.8125rem 0;
    font-family: var(--sans);
    font-size: 1.1875rem;
    font-weight: 300;
    color: var(--ink);
    background: none;
    border: 0;
    border-block-end: 1px solid var(--silver);
    border-radius: 0;
    transition: border-color 200ms var(--ease);
  }
  .campo input:focus {
    border-color: var(--ink);
  }
  .campo input:not(:placeholder-shown):valid {
    border-color: var(--drift);
  }

  .campo textarea {
    padding: 1.125rem 1.25rem;
    font-family: var(--sans);
    font-size: 1.0625rem;
    font-weight: 300;
    line-height: 1.7;
    color: var(--ink);
    background: none;
    border: 1px solid var(--silver);
    border-radius: 0;
    resize: vertical;
    transition: border-color 200ms var(--ease);
  }
  .campo textarea:focus {
    border-color: var(--ink);
  }

  .escolha {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .escolha > legend {
    padding: 0;
    margin-block-end: 1.125rem;
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    font-weight: 300;
    line-height: 1.5;
    color: var(--ink);
  }

  .opcoes {
    display: flex;
    flex-direction: column;
  }

  /* a opção inteira é alvo de toque, e a marca de seleção é um filete */
  .opcao {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    min-height: 44px;
    padding: 0.9375rem 0.875rem 0.9375rem 0;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--coffee);
    cursor: pointer;
    border-block-end: 1px solid var(--hairline-soft);
    transition: color 180ms var(--ease), border-color 180ms var(--ease);
  }
  .opcao:hover {
    color: var(--ink);
    border-color: var(--silver);
  }
  .opcao:has(input:checked) {
    color: var(--ink);
    border-color: var(--ink);
  }
  .opcao input {
    flex: 0 0 auto;
    width: 0.9375rem;
    height: 0.9375rem;
    margin-block-start: 0.3125rem;
    accent-color: var(--ink);
    cursor: pointer;
  }

  /* a pergunta de compromisso é a única da etapa, então pesa mais */
  .etapa[data-num='07'] .escolha > legend {
    font-size: clamp(1.0625rem, 1.9vw, 1.375rem);
    line-height: 1.55;
  }
  .etapa[data-num='07'] .opcao {
    padding-block: 1.125rem;
    font-size: clamp(1.0625rem, 1.6vw, 1.125rem);
  }

  .lgpd {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    grid-column: 1 / -1;
  }
  .lgpd input {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
    margin-block-start: 0.3125rem;
    accent-color: var(--ink);
    cursor: pointer;
  }
  .lgpd label {
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--coffee);
    cursor: pointer;
  }
  .lgpd a {
    color: var(--ink);
    text-decoration: none;
    border-block-end: 1px solid var(--drift);
  }

  .armadilha {
    position: absolute;
    inset-inline-start: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .erro {
    max-width: 44rem;
    margin-block-start: 2rem;
    border-inline-start: 2px solid var(--ink);
    padding-inline-start: 1.125rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--coffee);
  }
  .erro[hidden] {
    display: none;
  }

  .controles {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    max-width: 44rem;
    margin-block-start: clamp(2.5rem, 4vw, 3.5rem);
    border-block-start: 1px solid var(--hairline);
    padding-block-start: 1.75rem;
  }
  .controles[hidden] {
    display: none;
  }
  .voltar {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 44px;
    padding: 0;
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--drift-ink);
    background: none;
    border: 0;
    cursor: pointer;
    transition: color 200ms var(--ease);
  }
  .voltar:hover {
    color: var(--ink);
  }
  .voltar[hidden] {
    visibility: hidden;
  }
  .controles .btn {
    margin-inline-start: auto;
  }
  .controles .btn[hidden] {
    display: none;
  }

  .enviar-noscript {
    margin-block-start: 2.5rem;
  }

  /* o que acontece depois */
  .depois[hidden] {
    display: none;
  }
  .passos {
    display: grid;
    gap: 2rem 0;
    margin: clamp(2rem, 3vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 62rem) {
    .passos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .passo {
      padding-inline-end: 4rem;
    }
    .passo + .passo {
      border-inline-start: 1px solid var(--hairline);
      padding-inline-start: 4rem;
    }
  }
  .passo {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .passo__num {
    font-size: 0.6875rem;
    letter-spacing: 0.24em;
    color: var(--drift);
  }
  .passo p {
    font-size: clamp(1rem, 1.6vw, 1.125rem);
    line-height: 1.7;
  }

  /* confirmação */
  .confirma {
    margin-block-start: clamp(4rem, 7vw, 6.5rem);
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--ink);
    color: var(--silver);
  }
  .confirma[hidden] {
    display: none;
  }
  .confirma__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 7.5rem);
    align-items: start;
  }
  @media (min-width: 62rem) {
    .confirma__grid {
      grid-template-columns: minmax(0, 38.75rem) minmax(0, 1fr);
    }
  }
  .confirma__title {
    font-size: clamp(2.125rem, 4.5vw, 3.125rem);
    color: var(--alyssum);
  }
  .confirma__texto {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
  }
  .confirma__texto p {
    line-height: 1.8;
  }
  .confirma__forte {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    color: var(--alyssum);
  }
  .confirma__voltar {
    color: var(--alyssum);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('#diagnostico')!;
  const abertura = document.querySelector<HTMLElement>('#abertura')!;
  const comecar = document.querySelector<HTMLButtonElement>('[data-comecar]')!;
  const etapas = [...form.querySelectorAll<HTMLFieldSetElement>('.etapa')];
  const progresso = form.querySelector<HTMLElement>('[data-progresso]')!;
  const barra = form.querySelector<HTMLElement>('[data-barra]')!;
  const passoNum = form.querySelector<HTMLElement>('[data-passo-num]')!;
  const passoNome = form.querySelector<HTMLElement>('[data-passo-nome]')!;
  const controles = form.querySelector<HTMLElement>('[data-controles]')!;
  const btnVoltar = form.querySelector<HTMLButtonElement>('[data-voltar]')!;
  const btnAvancar = form.querySelector<HTMLButtonElement>('[data-avancar]')!;
  const btnEnviar = form.querySelector<HTMLButtonElement>('[data-enviar]')!;
  const erro = document.querySelector<HTMLElement>('#form-erro')!;
  const depois = document.querySelector<HTMLElement>('[data-depois]')!;
  const confirmacao = document.querySelector<HTMLElement>('#confirmacao')!;

  /**
   * Edge Function do Supabase. Enquanto a variável não estiver definida, o
   * envio segue o fluxo completo na tela mas nada sai do navegador — é o que
   * permite testar a experiência antes do backend estar no ar.
   */
  const ENDPOINT = import.meta.env.PUBLIC_DIAGNOSTICO_ENDPOINT ?? '';

  /** Erro que o servidor explicou, como o limite de envios. */
  class Respondeu extends Error {
    constructor(readonly status: number, readonly mensagem?: string) {
      super(mensagem ?? String(status));
    }
  }

  /** Rascunho local, para quem fecha a aba no meio. Apagado ao enviar. */
  const RASCUNHO = 'feitto.diagnostico.rascunho';
  const RASCUNHO_DIAS = 7;

  const ultima = etapas.length - 1;
  let atual = 0;

  const condicionais = [...form.querySelectorAll<HTMLElement>('[data-se-campo]')];

  form.classList.add('is-stepped');
  progresso.hidden = false;
  controles.hidden = false;

  restaurar();
  aplicarCondicoes();
  mostrar(0, { rolar: false });

  /* ---------------------------------------------------------------- *
   * campos condicionais
   * ---------------------------------------------------------------- */

  /**
   * Um campo escondido por condição fica disabled: fora da validação, fora
   * do Tab e fora do FormData. Sem isso, o required de uma pergunta que a
   * pessoa nunca viu trava o envio com uma mensagem invisível.
   */
  function aplicarCondicoes() {
    for (const bloco of condicionais) {
      const nome = bloco.dataset.seCampo!;
      const esperado = bloco.dataset.seValor!;
      const marcado = form.querySelector<HTMLInputElement>(`[name="${nome}"]:checked`);
      const valor = marcado?.value ?? (form.elements.namedItem(nome) as HTMLInputElement | null)?.value;
      const mostrar = valor === esperado;
      const exigido = bloco.dataset.req === 'sim';

      bloco.toggleAttribute('data-ativo', mostrar);

      const campos = [...bloco.querySelectorAll<HTMLInputElement>('input, textarea')];
      campos.forEach((campo, i) => {
        campo.disabled = !mostrar;
        // num grupo de rádios basta o primeiro carregar o required
        if (exigido) campo.required = mostrar && (campo.type !== 'radio' || i === 0);
      });
    }
  }

  form.addEventListener('change', () => {
    aplicarCondicoes();
    salvar();
  });
  form.addEventListener('input', salvar);

  /* ---------------------------------------------------------------- *
   * rascunho
   * ---------------------------------------------------------------- */

  function salvar() {
    try {
      const dados = coletar();
      localStorage.setItem(RASCUNHO, JSON.stringify({ at: Date.now(), passo: atual, dados }));
    } catch {
      /* storage bloqueado: o formulário segue, só não guarda rascunho */
    }
  }

  function restaurar() {
    try {
      const bruto = localStorage.getItem(RASCUNHO);
      if (!bruto) return;

      const { at, dados } = JSON.parse(bruto) as { at: number; dados: Record<string, string> };
      if (!at || (Date.now() - at) / 86_400_000 > RASCUNHO_DIAS) {
        localStorage.removeItem(RASCUNHO);
        return;
      }

      for (const [nome, valor] of Object.entries(dados)) {
        if (!valor) continue;
        const campos = form.querySelectorAll<HTMLInputElement>(`[name="${nome}"]`);
        for (const campo of campos) {
          if (campo.type === 'radio') campo.checked = campo.value === valor;
          else if (campo.type === 'checkbox') campo.checked = valor === 'on';
          else campo.value = valor;
        }
      }
    } catch {
      /* rascunho corrompido: começa do zero */
    }
  }

  function limparRascunho() {
    try {
      localStorage.removeItem(RASCUNHO);
    } catch {
      /* nada a fazer */
    }
  }

  /** As etapas fora de cena estão disabled, então FormData viria vazia. */
  function coletar(): Record<string, string> {
    const travadas = etapas.map((e) => e.disabled);
    for (const etapa of etapas) etapa.disabled = false;
    aplicarCondicoes(); // condicionais escondidas continuam de fora

    const dados = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;

    etapas.forEach((etapa, i) => (etapa.disabled = travadas[i]));
    return dados;
  }

  /* ---------------------------------------------------------------- *
   * navegação
   * ---------------------------------------------------------------- */

  function mostrar(indice: number, opcoes: { rolar?: boolean } = {}) {
    atual = Math.max(0, Math.min(indice, ultima));

    etapas.forEach((etapa, i) => {
      etapa.hidden = i !== atual;
      etapa.disabled = i !== atual;
    });
    aplicarCondicoes();

    const etapa = etapas[atual];
    passoNum.textContent = etapa.dataset.num ?? '';
    passoNome.textContent = etapa.dataset.nome ?? '';
    barra.style.width = `${((atual + 1) / etapas.length) * 100}%`;

    btnVoltar.hidden = atual === 0;
    btnAvancar.hidden = atual === ultima;
    btnEnviar.hidden = atual !== ultima;
    erro.hidden = true;

    if (opcoes.rolar !== false) {
      progresso.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
    etapa.querySelector<HTMLElement>('input:not([disabled]), textarea:not([disabled])')
      ?.focus({ preventScroll: true });
  }

  /** Valida só a etapa visível. As outras estão disabled e ficam de fora. */
  function etapaValida(): boolean {
    const campos = [...etapas[atual].querySelectorAll<HTMLInputElement>('input, textarea')];
    for (const campo of campos) {
      if (campo.disabled) continue;
      if (!campo.checkValidity()) {
        campo.reportValidity();
        campo.focus({ preventScroll: true });
        return false;
      }
    }
    return true;
  }

  comecar.addEventListener('click', () => {
    abertura.hidden = true;
    depois.hidden = true;
    mostrar(0);
  });

  btnAvancar.addEventListener('click', () => {
    if (etapaValida()) {
      salvar();
      mostrar(atual + 1);
    }
  });

  btnVoltar.addEventListener('click', () => mostrar(atual - 1));

  // Enter avança em vez de enviar, exceto na última etapa
  form.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter') return;
    if ((event.target as HTMLElement).tagName === 'TEXTAREA') return;
    if (atual !== ultima) {
      event.preventDefault();
      if (etapaValida()) mostrar(atual + 1);
    }
  });

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    erro.hidden = true;
    if (!etapaValida()) return;

    btnEnviar.disabled = true;
    btnEnviar.textContent = 'Enviando…';
    const dados = coletar();

    try {
      if (ENDPOINT) {
        const resposta = await fetch(ENDPOINT, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(dados),
        });
        if (!resposta.ok) {
          const detalhe = await resposta.json().catch(() => null);
          throw new Respondeu(resposta.status, detalhe?.erro);
        }
      } else {
        console.info('[diagnóstico] endpoint ainda não configurado. Respostas:', dados);
      }

      limparRascunho();
      form.hidden = true;
      abertura.hidden = true;
      depois.hidden = true;
      confirmacao.hidden = false;
      confirmacao.scrollIntoView({ behavior: 'smooth', block: 'start' });
      confirmacao.focus({ preventScroll: true });
    } catch (e) {
      btnEnviar.disabled = false;
      btnEnviar.textContent = 'Enviar minhas respostas';
      erro.hidden = false;
      erro.textContent =
        e instanceof Respondeu && e.mensagem
          ? `${e.mensagem} Suas respostas ficaram guardadas neste navegador.`
          : 'Não consegui enviar agora. Suas respostas ficaram guardadas neste navegador. Tente de novo em instantes ou me escreva em contato@feitto.com.br que eu leio do mesmo jeito.';
    }
  });
</script>
