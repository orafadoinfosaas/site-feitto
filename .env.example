# ------------------------------------------------------------------
# MCP do Supabase (lido pelo .mcp.json na abertura do Claude Code)
# O servidor sobe em --read-only e escopado a um único projeto: mesmo
# que algo injete instrução, não há caminho de escrita nem acesso aos
# outros projetos da conta.
# ------------------------------------------------------------------
SUPABASE_PROJECT_REF=          # ref do projeto, ex.: abcdefghijklmnop
SUPABASE_ACCESS_TOKEN=         # Personal Access Token: supabase.com/dashboard/account/tokens

# ------------------------------------------------------------------
# Secrets da Edge Function (NÃO vão para o navegador)
# Definir com: npx supabase secrets set CHAVE=valor
# ------------------------------------------------------------------
CLICKUP_TOKEN=                 # token pessoal da API do ClickUp
CLICKUP_LIST_ID=               # lista onde cada lead vira um card
SITE_ORIGIN=https://feitto.com.br   # origem liberada no CORS
RATE_LIMIT_SALT=               # string aleatória para o hash de IP

# ------------------------------------------------------------------
# Usado pelo site (público, pode aparecer no bundle)
# ------------------------------------------------------------------
PUBLIC_DIAGNOSTICO_ENDPOINT=   # https://<ref>.supabase.co/functions/v1/diagnostico
