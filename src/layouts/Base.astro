---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  /** o hero de tela cheia pede a barra flutuando por cima da foto */
  overlayNav?: boolean;
  aviso?: boolean;
  /** páginas de conversão e legais navegam sem menu completo */
  bare?: boolean;
}

const { title, description, overlayNav = false, aviso = true, bare = false } = Astro.props;

/* Reforço opcional: o nginx já manda X-Robots-Tag noindex para todo host que
   não seja o domínio final (ver docker/nginx.conf). Esta variável existe para
   quem servir o site sem aquele nginx. */
const naoIndexar = import.meta.env.PUBLIC_NOINDEX === 'true';
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR" class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="FEITTO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />

    {naoIndexar && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1C1619" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      href="/fonts/Author-ExtraLight.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/outfit-normal-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
  </head>

  <body>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>

    {!bare && <Nav overlay={overlayNav} current={current} aviso={aviso} />}
    {
      bare && (
        <header class="bare-nav">
          <a href="/" aria-label="FEITTO, página inicial" class="bare-nav__logo">
            <slot name="bare-logo" />
          </a>
          <a href="/" class="bare-nav__back">
            <span aria-hidden="true">←</span> Voltar ao site
          </a>
        </header>
      )
    }

    <main id="conteudo">
      <slot />
    </main>

    <Footer />
    <CookieConsent />

    <style>
      .bare-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        min-height: 5.5rem;
        padding-inline: var(--gutter);
        border-block-end: 1px solid var(--hairline);
      }
      .bare-nav__logo {
        display: flex;
        align-items: center;
        color: var(--ink);
      }
      .bare-nav__back {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        min-height: 44px;
        font-size: 0.75rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--coffee);
      }
      .bare-nav__back:hover {
        color: var(--ink);
      }
    </style>

    <script>
      /* Revelação: opacidade 0→1 com y 18→0, 620ms, curva (0.16,1,0.3,1),
         cascata de 70ms entre irmãos. Uma vez só, no primeiro encontro. */
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              const el = entry.target as HTMLElement;
              const step = Number(el.dataset.revealStep ?? 0);
              el.style.setProperty('--reveal-delay', `${step * 70}ms`);
              el.classList.add('is-revealed');
              io.unobserve(el);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.1 }
        );

        for (const el of items) io.observe(el);
      } else {
        for (const el of items) el.classList.add('is-revealed');
      }
    </script>
  </body>
</html>
